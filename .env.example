# ── Сайт ──
NEXT_PUBLIC_SITE_URL=https://vilamandara.bg

# ── Контакти (placeholders — потребителят ще ги даде) ──
NEXT_PUBLIC_CONTACT_EMAIL=contact@vilamandara.bg
NEXT_PUBLIC_CONTACT_PHONE=+359 000 000 000
NEXT_PUBLIC_WHATSAPP=+359 000 000 000

# ── Социални (placeholders) ──
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/vilamandara
NEXT_PUBLIC_INSTAGRAM_HANDLE=@vilamandara
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/vilamandara

# ── Локация / карта (placeholders — Горна Ковачица) ──
NEXT_PUBLIC_MAP_LAT=0
NEXT_PUBLIC_MAP_LNG=0

# ── Цени (публични — за маркетинг „от …" и живата цена в резервациите) ──
# Цялата вила: делник (пн–чт+нд) и уикенд (пт+сб) на нощувка.
NEXT_PUBLIC_PRICE_VILLA_WEEKDAY=500
NEXT_PUBLIC_PRICE_VILLA_WEEKEND=700
# Единична стая на нощ.
NEXT_PUBLIC_PRICE_ROOM_NIGHT=180
# Един шезлонг на ден.
NEXT_PUBLIC_PRICE_LOUNGER_DAY=18
# UI таван за поле „брой шезлонги" (настрой към реалния брой край басейна).
NEXT_PUBLIC_LOUNGER_MAX=8

# ── Запитване (форма) ──
# Formspree form id — НЕ е тайна (публичен endpoint). Регистрирай форма на formspree.io.
NEXT_PUBLIC_FORMSPREE_ID=__TBD__

# ── Smoobu (наличност — само сървър) ──
# ТАЕН ключ! Без NEXT_PUBLIC_ — никога не стига до браузъра. Settings → For developers.
SMOOBU_API_KEY=__TBD__
# Apartment id-та на 7-те обекта в Smoobu (вила + 6 стаи). Виж slug-овете в lib/content/rooms.ts.
SMOOBU_APARTMENT_VILLA=__TBD__
SMOOBU_APARTMENT_DAWN=__TBD__
SMOOBU_APARTMENT_SUNRISE=__TBD__
SMOOBU_APARTMENT_NOON=__TBD__
SMOOBU_APARTMENT_SUNSET=__TBD__
SMOOBU_APARTMENT_DUSK=__TBD__
SMOOBU_APARTMENT_NIGHT=__TBD__
# Споделена тайна за Smoobu webhook → незабавно обновяване на наличността след одобрение.
SMOOBU_REVALIDATE_WEBHOOK_SECRET=__TBD__
