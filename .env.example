# ── Сайт ──
NEXT_PUBLIC_SITE_URL=https://vilamandara.bg

# ── Контакти ──
NEXT_PUBLIC_CONTACT_EMAIL=mandara.houses@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+359 889 966 694
NEXT_PUBLIC_WHATSAPP=+359 889 966 694

# ── Социални ──
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/mandara.houses/
NEXT_PUBLIC_INSTAGRAM_HANDLE=@mandara.houses
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/mandara.houses/
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@mandara.village

# ── Локация / карта (placeholders — Горна Ковачица) ──
NEXT_PUBLIC_MAP_LAT=0
NEXT_PUBLIC_MAP_LNG=0

# ── Цени (публични — за маркетинг „от …") ──
# Цялата вила: делник (пн–чт+нд) и уикенд (пт+сб) на нощувка.
NEXT_PUBLIC_PRICE_VILLA_WEEKDAY=500
NEXT_PUBLIC_PRICE_VILLA_WEEKEND=700

# ── Депозит (Stripe Payment Link — публичен, не е тайна) ──
# Линкът и сумата трябва да съвпадат по стойност (линкът е с фиксирани 500 €).
NEXT_PUBLIC_STRIPE_DEPOSIT_URL=https://buy.stripe.com/4gM28ke1T2Aq3MI423fEk17
NEXT_PUBLIC_DEPOSIT_AMOUNT=500

# ── Smoobu (наличност + създаване на резервации — само сървър) ──
# ТАЕН ключ! Без NEXT_PUBLIC_ — никога не стига до браузъра. Settings → For developers.
# Формата „Резервирай" създава резервация през този ключ (канал „Direct booking").
SMOOBU_API_KEY=__TBD__
# Apartment id на вилата (задължителен за наличност и резервации).
SMOOBU_APARTMENT_VILLA=__TBD__
# Канал, по който влизат резервациите от сайта. Празно = „Direct booking" (6655906).
# Активираш ли „Website" канал в Smoobu, сложи неговото id тук.
SMOOBU_BOOKING_CHANNEL_ID=
